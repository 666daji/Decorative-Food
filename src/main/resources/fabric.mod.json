{
	"schemaVersion": 1,
	"id": "decorative-food",
	"version": "${version}",
	"name": "TW`s Decorative Food",
	"description": "Make the food placeable.Decorate your world!",
    "authors": ["Tenacious Wonder"],
    "contact": {
      "homepage": "https://modrinth.com/mod/decorative-food",
      "sources": "https://github.com/666daji/Decorative-Food",
      "issues": "https://github.com/666daji/Decorative-Food/issues"
    },
	"license": "MIT License",
	"icon": "assets/dfood/icon.jpg",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.dfood.ThreedFood"
		],
		"client": [
			"org.dfood.ThreedfoodClient"
		],
		"fabric-datagen": [
			"org.dfood.ThreedfoodDataGenerator"
		],
        "jade": [
          "org.dfood.jade.FoodBlockPlugin"
        ]
	},
	"mixins": [
		"3dfood.mixins.json",
		{
			"config": "3dfood.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.19",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}